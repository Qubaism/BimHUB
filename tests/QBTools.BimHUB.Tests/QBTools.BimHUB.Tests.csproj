<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net48'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net8'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net10'">net10.0-windows</TargetFramework>
    <Net48ReferenceAssembliesRoot Condition="'$(TargetFramework)' == 'net48' and '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net48\1.0.3\build\</Net48ReferenceAssembliesRoot>
    <Net48ReferenceAssembliesRoot Condition="'$(TargetFramework)' == 'net48' and '$(Net48ReferenceAssembliesRoot)' == ''">$(UserProfile)\.nuget\packages\microsoft.netframework.referenceassemblies.net48\1.0.3\build\</Net48ReferenceAssembliesRoot>
    <TargetFrameworkRootPath Condition="'$(TargetFramework)' == 'net48' and Exists('$(Net48ReferenceAssembliesRoot).NETFramework\v4.8\mscorlib.dll')">$(Net48ReferenceAssembliesRoot)</TargetFrameworkRootPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <RevitInstallDirectory Condition="'$(RevitInstallDirectory)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDirectory>
    <RevitApiDirectory Condition="'$(RevitApiDirectory)' == ''">$(RevitInstallDirectory)</RevitApiDirectory>
    <OutputPath>bin\$(Configuration)\$(RevitBuildTarget)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3"
                      PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBTools.BimHUB\QBTools.BimHUB.csproj" />
    <Reference Include="RevitAPI" HintPath="$(RevitApiDirectory)\RevitAPI.dll" Private="true" />
    <Reference Include="RevitAPIUI" HintPath="$(RevitApiDirectory)\RevitAPIUI.dll" Private="true" />
  </ItemGroup>
  <Target Name="ValidateRevitBuildTarget" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026' and '$(RevitVersion)' != '2027'"
      Text="RevitVersion must be between 2023 and 2027." />
    <Error
      Condition="'$(RevitRuntime)' != 'net48' and '$(RevitRuntime)' != 'net8' and '$(RevitRuntime)' != 'net10'"
      Text="RevitRuntime must be net48, net8, or net10." />
    <Error
      Condition="('$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024') and '$(RevitRuntime)' != 'net48'"
      Text="Revit $(RevitVersion) must be tested with RevitRuntime=net48." />
    <Error
      Condition="('$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026') and '$(RevitRuntime)' != 'net8' and '$(RevitRuntime)' != 'net10'"
      Text="Revit $(RevitVersion) must be tested with RevitRuntime=net8 or net10." />
    <Error
      Condition="'$(RevitVersion)' == '2027' and '$(RevitRuntime)' != 'net10'"
      Text="Revit 2027 must be tested with RevitRuntime=net10." />
  </Target>
</Project>
