<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net48'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net8'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitRuntime)' == 'net10'">net10.0-windows</TargetFramework>
    <Net48ReferenceAssembliesRoot Condition="'$(TargetFramework)' == 'net48' and '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net48\1.0.3\build\</Net48ReferenceAssembliesRoot>
    <Net48ReferenceAssembliesRoot Condition="'$(TargetFramework)' == 'net48' and '$(Net48ReferenceAssembliesRoot)' == ''">$(UserProfile)\.nuget\packages\microsoft.netframework.referenceassemblies.net48\1.0.3\build\</Net48ReferenceAssembliesRoot>
    <TargetFrameworkRootPath Condition="'$(TargetFramework)' == 'net48' and Exists('$(Net48ReferenceAssembliesRoot).NETFramework\v4.8\mscorlib.dll')">$(Net48ReferenceAssembliesRoot)</TargetFrameworkRootPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net48'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QBTools.BimHUB</AssemblyName>
    <RootNamespace>QBTools.BimHUB</RootNamespace>
    <RevitInstallDirectory Condition="'$(RevitInstallDirectory)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDirectory>
    <RevitApiDirectory Condition="'$(RevitApiDirectory)' == ''">$(RevitInstallDirectory)</RevitApiDirectory>
    <OutputPath>bin\$(Configuration)\$(RevitBuildTarget)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BimHUB-16.png" />
    <Resource Include="Assets\BimHUB-32.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common"
                      Version="8.0.0"
                      Condition="'$(TargetFramework)' == 'net8.0-windows'">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3"
                      PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="System.Text.Json"
                      Version="8.0.5"
                      Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDirectory)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDirectory)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRevitVersion" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026' and '$(RevitVersion)' != '2027'"
      Text="RevitVersion must be between 2023 and 2027." />
    <Error
      Condition="'$(RevitRuntime)' != 'net48' and '$(RevitRuntime)' != 'net8' and '$(RevitRuntime)' != 'net10'"
      Text="RevitRuntime must be net48, net8, or net10." />
    <Error
      Condition="('$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024') and '$(RevitRuntime)' != 'net48'"
      Text="Revit $(RevitVersion) must be built with RevitRuntime=net48." />
    <Error
      Condition="('$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026') and '$(RevitRuntime)' != 'net8' and '$(RevitRuntime)' != 'net10'"
      Text="Revit $(RevitVersion) must be built with RevitRuntime=net8 or net10." />
    <Error
      Condition="'$(RevitVersion)' == '2027' and '$(RevitRuntime)' != 'net10'"
      Text="Revit 2027 must be built with RevitRuntime=net10." />
    <Error
      Condition="!Exists('$(RevitApiDirectory)\RevitAPI.dll') or !Exists('$(RevitApiDirectory)\RevitAPIUI.dll')"
      Text="Revit $(RevitVersion) $(RevitRuntime) API assemblies were not found in $(RevitApiDirectory)." />
  </Target>

</Project>
